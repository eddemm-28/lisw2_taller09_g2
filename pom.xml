<?xml version="1.0" encoding="UTF-8"?>
<!--
  POM agregador: solo permite compilar/probar todos los microservicios con un unico comando
  (./mvnw clean package). Cada microservicio sigue siendo un proyecto Spring Boot autonomo
  con su propio pom.xml, puerto, base de datos y configuracion.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>co.edu.unicauca</groupId>
    <artifactId>lisw2_taller09_microservicios_g3</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <name>Taller 09 - Microservicios Saber PRO (Grupo 3)</name>

    <modules>
        <module>user-service</module>
        <module>validation-service</module>
        <module>question-service</module>
        <module>lifecycle-service</module>
        <module>review-service</module>
        <module>notification-service</module>
    </modules>
</project>
